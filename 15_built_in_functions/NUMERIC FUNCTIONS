-- =========================================
-- NUMERIC FUNCTIONS
-- Ceiling, Floor, Round, Trunc
-- =========================================

select
    avg(unit_price),
    ceiling(avg(unit_price)),
    floor(avg(unit_price)),
    round(cast(avg(unit_price) as numeric), 2),
    trunc(cast(avg(unit_price) as numeric), 2)
from products;


-- =========================================
-- TEXT FUNCTIONS
-- Upper, Lower, Length, Initcap, Replace
-- =========================================

select
    first_name,
    upper(first_name),
    lower(first_name),
    length(first_name),
    initcap('sql postgresql')
from employees;

select
    contact_name,
    contact_title,
    replace(contact_title, 'Owner', 'CEO')
from customers;


-- =========================================
-- SUBSTRINGS & STRING POSITION
-- Left, Right, Substring, Strpos
-- =========================================

select
    'ABC-9999',
    left('ABC-9999', 3),
    right('ABC-9999', 4);

select
    'ABC-9999',
    substring('ABC-9999', 1, 3),
    substring('ABC-9999', 5, 4),
    strpos('ABC-9999', '-');


-- =========================================
-- DATE FUNCTIONS
-- Current_Date, Age, Date_Part
-- =========================================

select
    first_name,
    birth_date,
    current_date,
    age(birth_date),
    age(hire_date),
    date_part('year', birth_date)
from employees;
