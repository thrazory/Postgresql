## CRUD Basics

```sql
-- Create and drop a database
CREATE DATABASE test;
DROP DATABASE test;

-- Create tables (without constraints)
CREATE TABLE alunos (
    ID_Aluno     INT,
    Nome_Aluno   VARCHAR(100),
    Email        VARCHAR(100)
);

CREATE TABLE cursos (
    ID_Curso     INT,
    Nome_Curso   VARCHAR(100),
    Preco_Curso  NUMERIC(10, 2)
);

CREATE TABLE matriculas (
    ID_Matricula  INT,
    ID_Aluno      INT,
    ID_Curso      INT,
    Data_Cadastro DATE
);

-- Query all records
SELECT * FROM alunos;
SELECT * FROM cursos;
SELECT * FROM matriculas;

-- Drop tables
DROP TABLE alunos;
DROP TABLE cursos;
DROP TABLE matriculas;
```

